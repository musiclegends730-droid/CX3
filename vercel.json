{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/cx3-calculator/package.json",
      "use": "@vercel/node",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "artifacts/api-server/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "artifacts/api-server/dist/index.mjs"
    },
    {
      "src": "^/(?!api)",
      "dest": "artifacts/cx3-calculator/dist/index.html"
    }
  ],
  "env": {
    "NODE_ENV": {
      "value": "production"
    }
  }
}
